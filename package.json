{
  "name": "iceslab",
  "version": "0.0.1",
  "private": true,
  "description": "Multi-core proxy panel with native Hysteria2, AmneziaWG, and NaiveProxy support",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": ">=8.0.2",
      "brace-expansion": ">=5.0.9",
      "fast-uri": ">=4.1.3",
      "mysql2": ">=3.22.0",
      "form-data": ">=4.0.6",
      "hono": ">=4.12.25",
      "@fastify/static": ">=10.1.1",
      "react-router": ">=7.18.0 <8"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-qwww-vcr4-c8h2"
      ]
    },
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ]
  }
}
