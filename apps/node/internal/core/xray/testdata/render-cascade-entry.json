  ],
  "policy": {
    "levels": {
      "0": {
        "statsUserDownlink": true,
        "statsUserUplink": true
      }
    },
    "system": {
      "statsInboundDownlink": true,
      "statsInboundUplink": true
    }
  },
  "routing": {
    "balancers": [
      {
        "tag": "bal-d1",
        "selector": [
          "cascade-link-out-d1-0",
          "cascade-link-out-d1-1"
        ],
        "strategy": {
          "type": "leastPing"
        }
      },
      {
        "tag": "bal-auto",
        "selector": [
          "cascade-link-out"
        ],
        "strategy": {
          "type": "leastPing"
        }
      }
    ],
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "inboundTag": [
          "api-in"
        ],
        "outboundTag": "api",
        "type": "field"
      },
      {
        "outboundTag": "dns-out",
        "protocol": [
          "dns"
        ],
        "type": "field"
      },
      {
        "outboundTag": "blocked",
        "protocol": [
          "bittorrent"
        ],
        "type": "field"
      },
      {
        "outboundTag": "blocked",
        "port": "25",
        "type": "field"
      },
      {
        "type": "field",
        "network": "udp",
        "port": 443,
        "outboundTag": "blocked"
      },
      {
        "type": "field",
        "vlessRoute": "1,257",
        "balancerTag": "bal-d1"
      },
      {
        "type": "field",
        "vlessRoute": "2,258",
        "outboundTag": "cascade-link-out-d2-0"
      },
      {
        "type": "field",
        "vlessRoute": "65535,65534",
        "network": "tcp,udp",
        "balancerTag": "bal-auto"
      }
    ]
  },
  "stats": {}
}