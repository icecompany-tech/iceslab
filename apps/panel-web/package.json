{
  "name": "@iceslab/panel-web",
  "private": true,
  "version": "0.4.0+dev",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "test": "vitest run && pnpm run test:tools",
    "test:tools": "node --test \"lint/*.test.mjs\" \"scripts/*.test.mjs\"",
    "test:watch": "vitest",
    "budget": "node scripts/budget.mjs dist",
    "preview": "vite preview"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.1",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-aria/optimize-locales-plugin": "^2.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "stylelint": "^18.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
