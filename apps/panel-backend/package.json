{
  "name": "@iceslab/panel-backend",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "predev": "node ./node_modules/prisma/build/index.js migrate deploy",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc",
    "prestart": "node ./node_modules/prisma/build/index.js migrate deploy",
    "start": "node --env-file=../../.env dist/index.js",
    "db:migrate": "node ./node_modules/prisma/build/index.js migrate deploy",
    "stress:users": "tsx scripts/stress-users.ts",
    "reset:admin": "tsx scripts/reset-admin.ts",
    "sync:recipes": "tsx scripts/sync-recipes.ts",
    "gen:recipe-schema": "tsx scripts/recipe-json-schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests"
  },
  "dependencies": {
    "@bull-board/api": "^7.2.1",
    "@bull-board/fastify": "^7.2.1",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.5",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@iceslab/shared": "workspace:*",
    "@peculiar/x509": "^2.2.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.5",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "mmdb-lib": "^3.0.3",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "prom-client": "^15.1.3",
    "qrcode-svg": "^1.1.0",
    "reflect-metadata": "^0.2.2",
    "undici": "^8.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
