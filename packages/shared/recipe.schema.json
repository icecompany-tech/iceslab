{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "engine": {
      "type": "string",
      "enum": [
        "native",
        "singbox"
      ]
    },
    "protocol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "subprotocol": {
      "type": "string",
      "enum": [
        "vless",
        "vmess",
        "trojan",
        "socks",
        "http"
      ]
    },
    "emoji": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "details": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "dpiResistance": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 3
        },
        {
          "type": "number",
          "const": 4
        },
        {
          "type": "number",
          "const": 5
        }
      ]
    },
    "speed": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 3
        },
        {
          "type": "number",
          "const": 4
        },
        {
          "type": "number",
          "const": 5
        }
      ]
    },
    "apply": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 48,
        "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 512
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "randomize": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48,
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "token8",
              "path",
              "password16",
              "awgHeader"
            ]
          }
        },
        "required": [
          "field",
          "kind"
        ]
      }
    },
    "notes": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 400
      }
    },
    "region": {
      "type": "string",
      "enum": [
        "GLOBAL",
        "RU",
        "IR",
        "CN",
        "BY",
        "OTHER"
      ]
    },
    "author": {
      "type": "string",
      "maxLength": 80
    },
    "verified": {
      "type": "boolean"
    },
    "minPanelVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "engine",
    "protocol",
    "emoji",
    "name",
    "description",
    "details",
    "dpiResistance",
    "speed",
    "apply"
  ],
  "$id": "https://raw.githubusercontent.com/icecompany-tech/iceslab/main/packages/shared/recipe.schema.json",
  "title": "Iceslab recipe",
  "if": {
    "properties": {
      "protocol": {
        "const": "xray"
      }
    },
    "required": [
      "protocol"
    ]
  },
  "then": {
    "required": [
      "subprotocol"
    ]
  },
  "else": {
    "not": {
      "required": [
        "subprotocol"
      ]
    }
  }
}
